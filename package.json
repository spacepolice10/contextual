{
  "name": "contextual",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.16.0 || >=24.0.0"
  },
  "scripts": {
    "build": "electron-forge package",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "electron-forge start",
    "make": "electron-forge make",
    "build:web": "vite build --config vite.renderer.config.ts --outDir dist-web",
    "web": "npm run build:web && tsx src/server/index.ts"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@types/node": "24.19.2",
    "electron": "45.4.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "tsx": "^4.20.0"
  },
  "description": "Local Mermaid diagram viewer",
  "main": ".vite/build/index.cjs",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@nanostores/router": "2.0.1",
    "drizzle-orm": "0.45.4",
    "nanostores": "1.5.5",
    "nanotags": "0.17.0",
    "pele": "1.13.0",
    "zod": "4.6.7",
    "hono": "^4.10.0",
    "@hono/node-server": "^1.19.0"
  }
}
